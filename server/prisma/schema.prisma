generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Multi-Agent 架构 - 扁平化 Agent 系统
// ============================================

// User - 用户
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sessions  Session[]
}

// ============================================
// 用户输入类型枚举
// ============================================

enum UserInputType {
  QUESTION     // 问题类：直接调用工具回答
  REQUIREMENT  // 需求类：多轮沟通确认后执行
  EXECUTION    // 执行类：直接分配任务
}

// 任务复杂度
enum TaskComplexity {
  SIMPLE       // 简单：直接执行，不过度拆分
  MEDIUM       // 中等：轻度拆分，适度思考
  COMPLEX      // 复杂：完整CoT，深度拆分，DAG执行
}

// 优化状态
enum OptimizationStatus {
  NORMAL
  PENDING
  OPTIMIZING
  OPTIMIZED
}

// ============================================
// 项目管理（新增）
// ============================================

// Project - 项目
model Project {
  id            String    @id @default(uuid())
  userId        String
  name          String
  description   String?

  // 项目配置
  agentTeam     Json?     // 项目专属的虚拟员工团队配置

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联
  sessions      Session[]
  performances  AgentPerformance[]

  @@index([userId])
}

// AgentPerformance - 数字员工绩效考核
model AgentPerformance {
  id                  String    @id @default(uuid())
  agentType           String
  projectId           String?

  // 考核指标
  totalTasks          Int       @default(0)
  successCount        Int       @default(0)
  failCount           Int       @default(0)
  rejectCount         Int       @default(0)
  avgDuration         Float     @default(0)    // 平均耗时（秒）

  // 自我优化触发
  rejectStreak        Int       @default(0)    // 连续被打回次数
  lastRejectAt        DateTime?

  // 优化状态
  optimizationStatus  OptimizationStatus @default(NORMAL)
  optimizationLog     Json?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // 关联
  project             Project?  @relation(fields: [projectId], references: [id])

  @@unique([agentType, projectId])
  @@index([agentType])
}

// Agent 类型枚举
enum AgentRole {
  SECRETARY   // 通用智能助理（秘书）
  SPECIALIST  // 领域专家
  TOOL        // 工具人
}

// 任务执行模式
enum ExecutionMode {
  SERIAL      // 串行
  PARALLEL    // 并行
  HYBRID      // 混合
}

// 会话状态
enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

// 产出物类型
enum ProductType {
  TEXT
  CODE
  FILE
  IMAGE
  VIDEO
  DATA
}

// ============================================
// 核心模型
// ============================================

// AgentProfile - 员工档案（扁平化角色）
model AgentProfile {
  id              String    @id @default(uuid())
  type            String    @unique  // secretary, specialist, tool
  name            String
  role            AgentRole

  // 身份设定
  corePrompt      String    @db.Text     // 核心身份设定
  decisionLogic   String    @db.Text     // CoA 决策逻辑

  // 能力配置
  maxConcurrentTasks Int   @default(3)
  timeout            Int   @default(300)
  retryCount         Int   @default(3)

  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联
  skills        AgentSkillBinding[]
  instances     AgentInstance[]

  @@index([type])
  @@index([role])
  @@index([isActive])
}

// AgentSkillBinding - Agent 与 Skill 关联
model AgentSkillBinding {
  id          String       @id @default(uuid())
  agentType   String
  skillId     String
  config      Json?        // { priority, enabled, customPrompt }

  agent       AgentProfile @relation(fields: [agentType], references: [type])
  skill       SkillProfile @relation(fields: [skillId], references: [id])

  @@unique([agentType, skillId])
}

// SkillProfile - 技能档案
model SkillProfile {
  id                 String    @id @default(uuid())
  type               String    @unique
  name               String
  description        String?

  // 技能设定核心
  skillPrompt        String    @db.Text  // 技能工作提示词
  chainOfThought     String    @db.Text  // 思维链

  // 执行配置
  isTool             Boolean   @default(false)
  toolDefinition     Json?     // { name, description, parameters }

  // 依赖和顺序
  dependsOn          String[]
  order              Int       @default(0)

  // 验收标准
  defaultAcceptanceCriteria Json?

  isActive           Boolean   @default(true)
  config             Json?     // 超时、重试等配置

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bindings           AgentSkillBinding[]

  @@index([type])
  @@index([isActive])
}

// VirtualEmployeeTemplate - 虚拟职员模板
model VirtualEmployeeTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  agentType   String   // 对应的 AgentProfile
  skillIds    String[]
  toolIds     String[]
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agentType])
}

// UserPreferenceModel - 用户偏好
model UserPreferenceModel {
  id                 String    @id @default(uuid())
  userId             String
  projectId          String?   // 可为空，表示全局偏好

  // 偏好数据
  decisionPattern    Json?     // 决策模式：激进/保守/数据驱动
  stylePreference    Json?     // 风格偏好
  communicationStyle Json?     // 沟通偏好

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([userId, projectId])
  @@index([userId])
}

// ============================================
// 会话级别模型（Multi-Agent 核心）
// ============================================

// Session - 会话
model Session {
  id            String    @id @default(uuid())
  projectId     String    // 所属项目
  userId        String
  title         String?

  // 当前负责的 Secretary Agent
  secretaryType String    @default("secretary")

  // 会话状态
  status        SessionStatus @default(ACTIVE)

  // 上下文摘要（用于长会话压缩）
  contextSummary String?  @db.Text

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联
  project       Project       @relation(fields: [projectId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  instances     AgentInstance[]
  tasks         Task[]
  contexts      Context[]
  products      WorkProduct[]
  attachments   Attachment[]
  summaries     ContextSummary[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

// AgentInstance - Agent 运行实例
model AgentInstance {
  id            String    @id @default(uuid())
  agentType     String    // secretary, specialist, tool
  sessionId     String

  // 扁平化：只保留 role
  role          AgentRole // secretary, specialist, tool

  // 状态
  status        String    @default("IDLE") // IDLE, RUNNING, WAITING, COMPLETED

  // 运行时上下文
  context       Json?     // 记忆、偏好、临时状态

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联
  session       Session   @relation(fields: [sessionId], references: [id])
  agent         AgentProfile? @relation(fields: [agentType], references: [type])
  tasks         Task[]

  @@index([sessionId])
  @@index([agentType])
}

// Task - 任务 (Multi-Agent 会话级别)
model Task {
  id            String    @id @default(uuid())
  sessionId     String
  agentInstanceId String?  // 执行此任务的 Agent

  // 任务定义
  name          String
  description   String?
  payload       Json?     // 任务输入数据

  // 任务分析（新增）
  inputType     UserInputType?  // QUESTION, REQUIREMENT, EXECUTION
  complexity    TaskComplexity? // SIMPLE, MEDIUM, COMPLEX

  // 执行模式
  executionMode ExecutionMode @default(SERIAL)
  status        String       @default("PENDING")

  // 验收标准
  acceptanceCriteria Json?  // { criteria: [], threshold: 0.8 }

  // 结果
  result        Json?     // 任务产出
  error         String?   // 错误信息

  // 时间戳
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  // 关联
  session       Session       @relation(fields: [sessionId], references: [id])
  agentInstance AgentInstance? @relation(fields: [agentInstanceId], references: [id])
  dependencies  TaskDependency[] @relation("DependentTask")
  dependents    TaskDependency[] @relation("DependencyTask")
  products      WorkProduct[]

  @@index([sessionId])
  @@index([status])
}

// TaskDependency - 任务依赖关系（DAG 边）
model TaskDependency {
  id             String    @id @default(uuid())
  taskId         String    // 依赖其他任务的任务
  dependsOnId    String    // 被依赖的任务

  task           Task      @relation("DependentTask", fields: [taskId], references: [id])
  dependsOn      Task      @relation("DependencyTask", fields: [dependsOnId], references: [id])

  @@unique([taskId, dependsOnId])
}

// Context - 上下文记录
model Context {
  id            String    @id @default(uuid())
  sessionId     String

  // 来源
  role          String    // user, assistant, agent, system
  sourceAgent   String?   // 产生此上下文的 Agent 类型

  // 内容
  content       String    @db.Text
  metadata      Json?     // { toolCalls: [], tokens: 123 }

  // 关联产物
  productId     String?   // 关联的工作产出

  createdAt     DateTime  @default(now())

  // 关联
  session       Session   @relation(fields: [sessionId], references: [id])
  product       WorkProduct? @relation(fields: [productId], references: [id])

  @@index([sessionId])
  @@index([createdAt])
}

// WorkProduct - 工作产出物
model WorkProduct {
  id            String    @id @default(uuid())
  sessionId     String
  taskId        String?
  agentType     String    // 产生此产出的 Agent 类型

  // 产出类型
  type          ProductType
  name          String
  content       String?   @db.Text  // 小内容直接存
  storageKey    String?   // 大内容存 OSS/S3

  // 元数据
  metadata      Json?

  // 验收状态
  acceptanceStatus String? // PENDING, APPROVED, REJECTED
  acceptanceNote   String?

  createdAt     DateTime  @default(now())

  // 关联
  session       Session   @relation(fields: [sessionId], references: [id])
  task          Task?     @relation(fields: [taskId], references: [id])
  contexts      Context[]

  @@index([sessionId])
  @@index([type])
}

// ContextSummary - 上下文摘要（长会话压缩）
model ContextSummary {
  id          String   @id @default(uuid())
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  summary     String    @db.Text
  tokenCount  Int?
  createdAt   DateTime @default(now())

  @@index([sessionId])
}

// ============================================
// 附件系统
// ============================================

// Attachment - 附件存储
model Attachment {
  id            String    @id @default(uuid())
  sessionId     String
  uploaderId    String    // 上传用户

  // 文件信息
  fileName      String
  fileType      String    // mime type
  fileSize      Int       // 字节
  storageType   String    // LOCAL, S3, OSS
  storagePath   String    // 存储路径

  // 智能分片
  isSharded     Boolean   @default(false)
  shardCount    Int       @default(0)

  // 状态
  status        String    @default("PENDING") // PENDING, PROCESSING, READY, FAILED

  // 元数据
  metadata      Json?     // { width, height, duration, pages }

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联
  session       Session   @relation(fields: [sessionId], references: [id])
  shards        AttachmentShard[]

  @@index([sessionId])
}

// AttachmentShard - 附件分片
model AttachmentShard {
  id              String    @id @default(uuid())
  attachmentId    String

  // 分片信息
  index           Int       // 分片序号
  content         String?   @db.Text  // 小内容直接存
  storageKey      String?   // 大内容存存储服务

  // 语义信息
  summary         String?   // 分片摘要
  keywords        String[]  // 关键词

  createdAt       DateTime  @default(now())

  // 关联
  attachment      Attachment @relation(fields: [attachmentId], references: [id])

  @@index([attachmentId])
}

// ============================================
// 会话恢复与离线支持
// ============================================

// SessionSnapshot - Session 恢复快照
model SessionSnapshot {
  id            String    @id @default(uuid())
  sessionId     String

  // 快照数据
  contextData   Json      // 上下文摘要
  taskState     Json      // 任务状态快照
  agentStates   Json      // Agent 状态快照

  // 恢复信息
  recoveryPoint String    // 恢复点标识
  createdAt     DateTime  @default(now())

  @@index([sessionId])
  @@index([recoveryPoint])
}

// TaskExecutionLog - 任务执行日志（用于恢复）
model TaskExecutionLog {
  id            String    @id @default(uuid())
  taskId        String
  sessionId     String

  // 执行步骤
  step          Int       // 步骤序号
  action        String    // 执行的动作
  input         Json?     // 输入数据
  output        Json?     // 输出数据
  status        String    // PENDING, SUCCESS, FAILED

  createdAt     DateTime  @default(now())

  @@index([taskId])
  @@index([sessionId])
}

// ============================================
// 领域知识系统
// ============================================

// DomainKnowledge - 领域知识
model DomainKnowledge {
  id            String    @id @default(uuid())
  domain        String    @unique  // 领域标识，如 "video_generation"
  name          String
  description   String?

  // 知识内容
  knowledge     String    @db.Text  // JSON 格式的知识

  // 分析结果
  analysis      String?   @db.Text  // 领域分析结果

  // 状态
  status        String    @default("PENDING") // PENDING, ANALYZING, READY, FAILED

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([domain])
}